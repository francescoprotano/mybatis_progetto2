<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="it.exolab.model.CorsoMapper">


   <insert id="insert" parameterType="it.exolab.model.Corso" 
  	useGeneratedKeys="true"
    	keyProperty="id"
  		keyColumn="id"
  >
    insert into corso (nome,aula,argomento) values (#{nome},#{aula},#{argomento}) 
  </insert>
  
  
  
   <select id="findAll" resultType="it.exolab.model.Corso" 
  	
  >
    select * from corso  order by id desc 
  </select>
  
  

  
</mapper>